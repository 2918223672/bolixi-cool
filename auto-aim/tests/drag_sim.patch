+const DRAG_STEP = 0.002
+
+func _drag_acc(velocity: Vector3) -> Vector3:
+	return Vector3(0, 0, -settings.weapon.gravity) \
+		- settings.weapon.drag_k * velocity.length() * velocity
+
+func _drag_path(initial_velocity: Vector3) -> Array[Vector3]:
+	var points: Array[Vector3] = [Vector3.ZERO]
+	var position := Vector3.ZERO
+	var velocity := initial_velocity
+	for _step in range(ceili(settings.weapon.lifetime / DRAG_STEP) + 1):
+		var a1 := _drag_acc(velocity)
+		var v2 := velocity + a1 * (DRAG_STEP * 0.5)
+		var a2 := _drag_acc(v2)
+		var v3 := velocity + a2 * (DRAG_STEP * 0.5)
+		var a3 := _drag_acc(v3)
+		var v4 := velocity + a3 * DRAG_STEP
+		var a4 := _drag_acc(v4)
+		position += (velocity + 2.0 * v2 + 2.0 * v3 + v4) * (DRAG_STEP / 6.0)
+		velocity += (a1 + 2.0 * a2 + 2.0 * a3 + a4) * (DRAG_STEP / 6.0)
+		points.append(position)
+		if position.z < -2.0:
+			break
+	return points
+
 func bullet_position(bullet: Dictionary, at: float) -> Vector3:
 	var age = maxf(0.0, at - bullet.born)
+	if bullet.has("drag_points"):
+		var points: Array = bullet.drag_points
+		var index := mini(int(age / DRAG_STEP), points.size() - 2)
+		var fraction := clampf(age / DRAG_STEP - index, 0.0, 1.0)
+		return bullet.origin + points[index].lerp(points[index + 1], fraction)
 	return bullet.origin + bullet.velocity * age + Vector3(0, 0, -0.5 * settings.weapon.gravity * age * age)
 
 
